{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 750,
  "height": 280,
  "title": {
    "text": "Archival Streamgraph Across Landmark Categories (1850–1950)",
    "subtitle": "Flow of historical photo acquisition over consecutive decades",
    "font": "Georgia",
    "fontSize": 18,
    "subtitleFont": "Georgia",
    "subtitleFontSize": 12,
    "subtitleColor": "#5c4f3d",
    "color": "#2c1d11",
    "anchor": "start"
  },
  "background": "#faf7f2",
  "data": {
    "url": "../data/melbourne_landmarks_historical.csv"
  },
  "transform": [
    {
      "filter": "datum.Decade != null"
    }
  ],
  "mark": "area",
  "encoding": {
    "x": {
      "field": "Decade",
      "type": "ordinal",
      "title": "Decade"
    },
    "y": {
      "aggregate": "count",
      "type": "quantitative",
      "title": "Collection Volume",
      "stack": "center",
      "axis": null
    },
    "color": {
      "field": "Category",
      "type": "nominal",
      "scale": {
        "scheme": "dark2"
      },
      "title": "Category"
    },
    "tooltip": [
      { "field": "Category", "type": "nominal", "title": "Category" },
      { "field": "Decade", "type": "nominal", "title": "Decade" },
      { "aggregate": "count", "type": "quantitative", "title": "Photos" }
    ]
  },
  "config": {
    "font": "Georgia",
    "legend": {
      "titleFont": "Georgia",
      "labelFont": "Georgia",
      "titleColor": "#2c1d11",
      "labelColor": "#4a3b2c",
      "fillColor": "#f4ede2",
      "padding": 10,
      "cornerRadius": 4,
      "strokeColor": "#d1c4b0"
    },
    "axis": {
      "titleFont": "Georgia",
      "labelFont": "Georgia",
      "titleColor": "#2c1d11",
      "labelColor": "#4a3b2c",
      "gridColor": "#e8e0d1",
      "domainColor": "#d1c4b0",
      "tickColor": "#d1c4b0"
    },
    "view": {
      "stroke": "transparent"
    }
  }
}