{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 500,
  "title": {
    "text": "Historical Melbourne Landmarks Photograph Locations (1850–1950)",
    "subtitle": "State Library Victoria Heritage Collection",
    "font": "Georgia",
    "fontSize": 18,
    "subtitleFont": "Georgia",
    "subtitleFontSize": 12,
    "subtitleColor": "#5c4f3d",
    "color": "#2c1d11",
    "anchor": "start"
  },
  "background": "#faf7f2",
  "projection": {
    "type": "equirectangular",
    "center": [144.96, -37.825],
    "scale": 320000
  },
  "params": [
    {
      "name": "Category_Filter",
      "bind": {
        "input": "select",
        "options": [
          null,
          "Civic and Government",
          "Commercial and Retail",
          "Cultural and Heritage",
          "Hospitality and Hotels",
          "Religious and Sacred",
          "Transport and Infra"
        ],
        "labels": [
          "Show All",
          "Civic and Government",
          "Commercial and Retail",
          "Cultural and Heritage",
          "Hospitality and Hotels",
          "Religious and Sacred",
          "Transport and Infra"
        ],
        "name": "Filter Category: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/6_advanced_examples/data/VIC_LOCALITY_POLYGON_SHP.json",
        "format": {
          "type": "topojson",
          "feature": "VIC_LOCALITY_POLYGON_SHP"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e8e0d1",
        "stroke": "#d1c4b0",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "../data/melbourne_landmarks_historical.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Latitude": "number",
            "Longitude": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "isValid(datum.Latitude) && isValid(datum.Longitude)"
        },
        {
          "filter": "Category_Filter == null || datum.Category == Category_Filter"
        },
        {
          "aggregate": [{"op": "count", "as": "Photo_Count"}],
          "groupby": ["Landmark_Name", "Latitude", "Longitude", "Decade", "Category"]
        }
      ],
      "mark": {
        "type": "circle",
        "stroke": "#3e2723",
        "strokeWidth": 0.8,
        "opacity": 0.85
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "Photo_Count",
          "type": "quantitative",
          "title": "Photo Count",
          "scale": {
            "range": [50, 350]
          },
          "legend": {
            "format": "d"
          }
        },
        "color": {
          "field": "Category",
          "type": "nominal",
          "scale": {
            "scheme": "dark2"
          },
          "title": "Category"
        },
        "tooltip": [
          { "field": "Landmark_Name", "type": "nominal", "title": "Landmark" },
          { "field": "Category", "type": "nominal", "title": "Category" },
          { "field": "Decade", "type": "nominal", "title": "Decade" },
          { "field": "Photo_Count", "type": "quantitative", "title": "Photos Held" }
        ]
      }
    }
  ],
  "config": {
    "font": "Georgia",
    "legend": {
      "titleFont": "Georgia",
      "labelFont": "Georgia",
      "titleColor": "#2c1d11",
      "labelColor": "#4a3b2c",
      "fillColor": "#f4ede2",
      "padding": 10,
      "cornerRadius": 4,
      "strokeColor": "#d1c4b0"
    },
    "view": {
      "stroke": "transparent"
    }
  }
}