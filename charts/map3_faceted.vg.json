{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 450,
  "title": {
    "text": "Interactive Era Exploration of Heritage Locations",
    "subtitle": "Filter by decade to explore temporal distribution across Greater Melbourne",
    "font": "Georgia",
    "fontSize": 18,
    "subtitleFont": "Georgia",
    "subtitleFontSize": 12,
    "subtitleColor": "#5c4f3d",
    "color": "#2c1d11",
    "anchor": "start"
  },
  "background": "#faf7f2",
  "params": [
    {
      "name": "Decade_Select",
      "bind": {
        "input": "select",
        "options": [null, "1850s", "1860s", "1870s", "1880s", "1890s", "1900s", "1910s", "1920s", "1930s", "1940s"],
        "labels": ["Show All Eras", "1850s", "1860s", "1870s", "1880s", "1890s", "1900s", "1910s", "1920s", "1930s", "1940s"],
        "name": "Select Era: "
      }
    }
  ],
  "projection": {
    "type": "equirectangular",
    "center": [144.96, -37.825],
    "scale": 320000
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/6_advanced_examples/data/VIC_LOCALITY_POLYGON_SHP.json",
        "format": {
          "type": "topojson",
          "feature": "VIC_LOCALITY_POLYGON_SHP"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e8e0d1",
        "stroke": "#d1c4b0",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "../data/melbourne_landmarks_historical.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Latitude": "number",
            "Longitude": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "isValid(datum.Latitude) && isValid(datum.Longitude)"
        },
        {
          "filter": "Decade_Select == null || datum.Decade == Decade_Select"
        }
      ],
      "mark": {
        "type": "circle",
        "stroke": "#2c1d11",
        "strokeWidth": 0.6,
        "opacity": 0.85
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "color": {
          "field": "Category",
          "type": "nominal",
          "scale": {
            "scheme": "dark2"
          },
          "title": "Category"
        },
        "size": {
          "value": 120
        },
        "tooltip": [
          { "field": "Landmark_Name", "type": "nominal", "title": "Landmark" },
          { "field": "Location", "type": "nominal", "title": "Locality" },
          { "field": "Decade", "type": "nominal", "title": "Decade" },
          { "field": "Category", "type": "nominal", "title": "Category" }
        ]
      }
    }
  ],
  "config": {
    "font": "Georgia",
    "legend": {
      "titleFont": "Georgia",
      "labelFont": "Georgia",
      "titleColor": "#2c1d11",
      "labelColor": "#4a3b2c",
      "fillColor": "#f4ede2",
      "padding": 10,
      "cornerRadius": 4,
      "strokeColor": "#d1c4b0"
    },
    "view": {
      "stroke": "transparent"
    }
  }
}